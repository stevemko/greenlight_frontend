}

function StockBadge({ status, label }) {
  const base = {
    display: 'inline-flex', alignItems: 'center', gap: '4px',
    padding: '3px 8px', borderRadius: '20px', fontSize: '10px',
    fontWeight: '700', letterSpacing: '0.5px', textTransform: 'uppercase',
    marginBottom: '8px',
  };
  if (status === 'in_stock') return (
    <div style={{ ...base, background: 'rgba(0,200,83,0.15)', border: '1px solid rgba(0,200,83,0.4)', color: '#00C853' }}>
      <span style={{ width: '6px', height: '6px', background: '#00C853', borderRadius: '50%', display: 'inline-block' }} />{label}
    </div>
  );
  if (status === 'limited') return (
    <div style={{ ...base, background: 'rgba(255,109,0,0.15)', border: '1px solid rgba(255,109,0,0.4)', color: '#FF6D00' }}>
      <span style={{ width: '6px', height: '6px', background: '#FF6D00', borderRadius: '50%', display: 'inline-block' }} />{label}
    </div>
  );
  return (
    <div style={{ ...base, background: 'rgba(211,47,47,0.15)', border: '1px solid rgba(211,47,47,0.4)', color: '#EF5350' }}>
      <span style={{ width: '6px', height: '6px', background: '#EF5350', borderRadius: '50%', display: 'inline-block' }} />{label}
    </div>
  );
}

function ProductCard({ product }) {
  const handleAddToCart = () => {
    if (product.stock_status === 'out_of_stock') return;
    window.dispatchEvent(new CustomEvent('addToCart', { detail: product }));
  };
  const isOutOfStock = product.stock_status === 'out_of_stock';
  return (
    <div className="product-card">
      <div style={{ position: 'relative', height: '160px', overflow: 'hidden', background: '#222', borderRadius: '16px 16px 0 0' }}>
        <img src={product.image} alt={product.name} loading="lazy"
          style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block', opacity: isOutOfStock ? 0.5 : 1 }} />
        <div style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: '60px', background: 'linear-gradient(to top, #1A1A1A, transparent)', pointerEvents: 'none' }} />
        {product.is_on_sale && (
          <div style={{ position: 'absolute', top: '8px', left: '8px', background: '#FF6D00', color: 'white', fontSize: '9px', fontWeight: '700', letterSpacing: '1px', textTransform: 'uppercase', padding: '3px 8px', borderRadius: '100px', zIndex: 2 }}>SALE</div>
        )}
        {isOutOfStock && (
          <div style={{ position: 'absolute', inset: 0, background: 'rgba(0,0,0,0.6)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 3 }}>
            <span style={{ background: '#D32F2F', color: 'white', padding: '6px 14px', borderRadius: '20px', fontWeight: '800', fontSize: '11px', letterSpacing: '1px', textTransform: 'uppercase' }}>Out of Stock</span>
          </div>
        )}
      </div>
      <div className="product-card-body">
        <div className="product-card-category">{product.category_name || 'Accessories'}</div>
        <h3 className="product-card-name">{product.name}</h3>
        <StockBadge status={product.stock_status} label={product.stock_label} />
        <div className="product-card-footer">
          <div className="product-price">
            <span className="product-price-label">Price</span>
            <span className="product-price-value">
              <span className="product-price-currency">Ksh </span>
              {Number(product.effective_price).toLocaleString()}
            </span>
            {product.is_on_sale && (
              <span style={{ fontSize: '11px', color: '#888', textDecoration: 'line-through', display: 'block' }}>
                Ksh {Number(product.price).toLocaleString()}
              </span>
            )}
          </div>
          <button
            className="add-to-cart-btn"
            onClick={handleAddToCart}
            disabled={isOutOfStock}
            style={{ opacity: isOutOfStock ? 0.4 : 1, cursor: isOutOfStock ? 'not-allowed' : 'pointer' }}
          >
            {isOutOfStock ? 'Sold Out' : '+ Cart'}
          </button>
        </div>
        <WhatsAppBtn product={product} />
      </div>
    </div>
  );
}

function Products({ searchQuery }) {
  const [masterList, setMasterList] = useState([]);
  const [categories, setCategories] = useState([]);
  const [activeFilter, setActiveFilter] = useState('All');
  const [visibleCount, setVisibleCount] = useState(BATCH_SIZE);
  const [loading, setLoading] = useState(true);
  const [loadingMore, setLoadingMore] = useState(false);
  const [error, setError] = useState(null);
  const [toast, setToast] = useState(null);
  const loaderRef = useRef(null);
  const gridRef = useRef(null);

  useEffect(() => {
    setLoading(true);
    Promise.all([API.get('categories/'), API.get('products/')])
      .then(([catRes, prodRes]) => {
        const cats = Array.isArray(catRes.data) ? catRes.data : catRes.data.results || [];
        const prods = Array.isArray(prodRes.data) ? prodRes.data : prodRes.data.results || [];
        setCategories(cats);
        setMasterList(prods);
      })
      .catch(() => setError('Failed to load products. Please refresh the page.'))
      .finally(() => setLoading(false));
  }, []);

  const filteredProducts = useMemo(() => {
    let list = masterList;
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      list = list.filter(p =>
        p.name.toLowerCase().includes(q) ||
        (p.category_name && p.category_name.toLowerCase().includes(q)) ||
        (p.description && p.description.toLowerCase().includes(q))
      );
    } else if (activeFilter !== 'All') {
      list = list.filter(p => p.category_name === activeFilter);
    }
    return list;
  }, [masterList, searchQuery, activeFilter]);

  useEffect(() => { setVisibleCount(BATCH_SIZE); }, [searchQuery, activeFilter]);

  const visibleProducts = filteredProducts.slice(0, visibleCount);
  const allLoaded = visibleCount >= filteredProducts.length;

  const loadMore = useCallback(() => {
    if (loadingMore || allLoaded) return;
    setLoadingMore(true);
    requestAnimationFrame(() => {
      setVisibleCount(prev => prev + BATCH_SIZE);
      setLoadingMore(false);
    });
  }, [loadingMore, allLoaded]);

  useEffect(() => {
    if (!loaderRef.current) return;
    const observer = new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) loadMore(); },
      { threshold: 0.1 }
    );
    observer.observe(loaderRef.current);
    return () => observer.disconnect();
  }, [loadMore]);

  useEffect(() => {
    if (!gridRef.current) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const idx = Number(entry.target.dataset.index || 0);
            setTimeout(() => entry.target.querySelector('.product-card')?.classList.add('visible'), (idx % BATCH_SIZE) * 60);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    gridRef.current.querySelectorAll('.product-card-wrapper').forEach(el => observer.observe(el));
    return () => observer.disconnect();
  }, [visibleProducts.length]);

  useEffect(() => {
    const handler = (e) => {
      setToast(e.detail.name);
      setTimeout(() => setToast(null), 3000);
    };
    window.addEventListener('addToCart', handler);
    return () => window.removeEventListener('addToCart', handler);
  }, []);

  const filterButtons = ['All', ...categories.map(c => c.name)];

  return (
    <section className="section products-section" id="products" style={{ paddingTop: '160px' }}>
      <div className="products-header">
        <div>
          <div className="section-tag">Our Collection</div>
          <h2 className="section-title">
            {searchQuery
              ? <span>Results for <span className="accent">"{searchQuery}"</span></span>
              : <span>Available <span className="accent">Products</span></span>}
          </h2>
          <p className="section-subtitle">
            {searchQuery
              ? `${filteredProducts.length} product${filteredProducts.length !== 1 ? 's' : ''} found`
              : 'Handpicked gear for the serious rider. Quality tested, rider approved.'}
          </p>
          {!searchQuery && (
            <div style={{ display: 'flex', gap: '16px', marginTop: '12px', flexWrap: 'wrap' }}>
              {[{ color: '#00C853', label: 'In Stock' }, { color: '#FF6D00', label: 'Limited Stock' }, { color: '#EF5350', label: 'Out of Stock' }].map(({ color, label }) => (
                <div key={label} style={{ display: 'flex', alignItems: 'center', gap: '6px', fontSize: '11px', color: '#888' }}>
                  <span style={{ width: '8px', height: '8px', background: color, borderRadius: '50%', display: 'inline-block' }} />{label}
                </div>
              ))}
            </div>
          )}
        </div>
        {!searchQuery && (
          <div className="products-filter">
            {filterButtons.map(f => (
              <button key={f} className={'filter-btn' + (activeFilter === f ? ' active' : '')} onClick={() => setActiveFilter(f)}>{f}</button>
            ))}
          </div>
        )}
      </div>

      {error && (
        <div style={{ background: 'rgba(211,47,47,0.1)', border: '1px solid rgba(211,47,47,0.3)', borderRadius: '12px', padding: '20px 24px', textAlign: 'center', color: '#EF5350', fontSize: '14px', marginBottom: '24px' }}>
          ⚠️ {error}
        </div>
      )}

      {loading ? (
        <div className="products-grid">
          {Array.from({ length: BATCH_SIZE }).map((_, i) => <SkeletonCard key={i} />)}
        </div>
      ) : filteredProducts.length === 0 ? (
        <div className="empty-state">
          <div className="empty-state-icon">🔍</div>
          <h3>{searchQuery ? 'No Results Found' : 'No Products Yet'}</h3>
          <p>{searchQuery ? 'Try a different search term or browse all products.' : 'Check back soon — new gear drops weekly.'}</p>
        </div>
      ) : (
        <div>
          <div className="products-grid" ref={gridRef}>
            {visibleProducts.map((product, i) => (
              <div key={product.id} data-index={i} className="product-card-wrapper">
                <ProductCard product={product} />
              </div>
            ))}
          </div>
          <div className="load-more-trigger" ref={loaderRef}>
            {loadingMore && <div className="load-more-spinner" />}
            {allLoaded && visibleProducts.length > 0 && <div className="all-loaded">You've seen it all</div>}
          </div>
        </div>
      )}

      {toast && (
        <div className="toast">
          <span className="toast-icon">✅</span>
          <span><strong>{toast}</strong> added to cart!</span>
        </div>
      )}
    </section>
  );
}

export default Products;

  );
  const deliveryFee = form.delivery_type === 'nairobi' ? 200
    : form.delivery_type === 'upcountry' ? 500 : 0;

  return (
    `Hello Greenlight Accessories! 👋\n\n` +
    `*Order Reference: ${orderNumber}*\n\n` +
    `*Customer:* ${form.customer_name}\n` +
    `*Delivery Area:* ${form.delivery_area || 'Not specified'}\n` +
    `*Delivery Type:* ${form.delivery_type === 'nairobi' ? 'Nairobi Delivery' : form.delivery_type === 'upcountry' ? 'Upcountry Delivery' : 'Pick Up'}\n` +
    `*Payment:* ${form.payment_method === 'mpesa' ? 'M-Pesa' : form.payment_method === 'cash' ? 'Cash on Delivery' : 'Bank Transfer'}\n\n` +
    `*Items Ordered:*\n${lines.join('\n')}\n\n` +
    `*Subtotal:* Ksh ${total.toLocaleString()}\n` +
    `*Delivery Fee:* Ksh ${deliveryFee.toLocaleString()}\n` +
    `*Total: Ksh ${(total + deliveryFee).toLocaleString()}*\n\n` +
    (form.notes ? `*Notes:* ${form.notes}\n\n` : '') +
    `Please confirm availability and delivery details. Thank you!`
  );
}

function openWhatsApp(message) {
  const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
  const a = document.createElement('a');
  a.href = url;
  a.target = '_blank';
  a.rel = 'noopener noreferrer';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
}

function Cart({ cart, onClose, onUpdateCart }) {
  const total = cart.reduce((sum, item) => sum + Number(item.effective_price) * item.quantity, 0);
  const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);

  const [step, setStep] = useState('cart');
  const [form, setForm] = useState({
    customer_name: '',
    delivery_area: '',
    delivery_type: 'nairobi',
    payment_method: 'mpesa',
    notes: '',
  });
  const [errors, setErrors] = useState({});

  const updateQuantity = (productId, newQty) => {
    if (newQty < 1) {
      onUpdateCart(cart.filter(item => item.id !== productId));
    } else {
      onUpdateCart(cart.map(item =>
        item.id === productId ? { ...item, quantity: newQty } : item
      ));
    }
  };

  const removeItem = (productId) => onUpdateCart(cart.filter(item => item.id !== productId));

  const validate = () => {
    const e = {};
    if (!form.customer_name.trim()) e.customer_name = 'Name is required';
    return e;
  };

  const deliveryFee = form.delivery_type === 'nairobi' ? 200
    : form.delivery_type === 'upcountry' ? 500 : 0;

  const handleCheckout = async () => {
    const e = validate();
    if (Object.keys(e).length > 0) { setErrors(e); return; }
    setStep('loading');

    const orderData = {
      customer_name:  form.customer_name,
      customer_phone: '',
      customer_email: '',
      delivery_area:  form.delivery_area,
      delivery_type:  form.delivery_type,
      payment_method: form.payment_method,
      delivery_fee:   deliveryFee,
      notes:          form.notes,
      source:         'whatsapp',
      items: cart.map(item => ({
        product:  item.id,
        quantity: item.quantity,
      })),
    };

    try {
      const res = await fetch(`${API_URL}orders/`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(orderData),
      });
      const data = await res.json();
      if (res.ok) {
        const message = buildWhatsAppMessage(cart, total, data.order_number, form);
        openWhatsApp(message);
        setStep('done');
        onUpdateCart([]);
      } else {
        console.error('Order error:', data);
        setStep('form');
        alert('Something went wrong. Please try again.');
      }
    } catch (err) {
      const message = buildWhatsAppMessage(cart, total, 'PENDING', form);
      openWhatsApp(message);
      setStep('done');
      onUpdateCart([]);
    }
  };

  const inputStyle = (field) => ({
    width: '100%', padding: '10px 14px',
    background: 'rgba(255,255,255,0.06)',
    border: errors[field] ? '1px solid #EF5350' : '1px solid rgba(255,255,255,0.1)',
    borderRadius: '10px', color: 'white', fontSize: '14px',
    fontFamily: "'Outfit', sans-serif", outline: 'none',
    marginBottom: errors[field] ? '2px' : '12px',
  });

  const labelStyle = {
    fontSize: '11px', color: '#888', textTransform: 'uppercase',
    letterSpacing: '1px', fontWeight: '600', marginBottom: '6px', display: 'block',
  };

  return (
    <>
      <div onClick={onClose} style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.7)', zIndex: 9000, backdropFilter: 'blur(4px)' }} />

      <div style={{ position: 'fixed', top: 0, right: 0, width: '100%', maxWidth: '420px', height: '100vh', background: '#1A1A1A', zIndex: 9001, display: 'flex', flexDirection: 'column', boxShadow: '-20px 0 60px rgba(0,0,0,0.5)', animation: 'slideInRight 0.3s ease' }}>

        {/* Header */}
        <div style={{ padding: '24px', borderBottom: '1px solid rgba(255,255,255,0.08)', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
          <div>
            <h2 style={{ fontFamily: "'Bebas Neue', sans-serif", fontSize: '28px', letterSpacing: '2px', color: 'white', margin: 0 }}>
              {step === 'form' ? 'Your Details' : step === 'done' ? 'Order Placed!' : 'Your Cart'}
            </h2>
            <p style={{ color: '#888', fontSize: '13px', margin: '4px 0 0' }}>
              {step === 'cart' && `${totalItems} item${totalItems !== 1 ? 's' : ''}`}
              {step === 'form' && 'Fill in your details to complete order'}
              {step === 'loading' && 'Saving your order...'}
              {step === 'done' && 'WhatsApp is opening...'}
            </p>
          </div>
          <button onClick={onClose} style={{ background: 'rgba(255,255,255,0.08)', border: '1px solid rgba(255,255,255,0.1)', color: 'white', width: '36px', height: '36px', borderRadius: '50%', cursor: 'pointer', fontSize: '18px', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>✕</button>
        </div>

        {/* ── STEP: Cart ── */}
        {step === 'cart' && (
          <>
            <div style={{ flex: 1, overflowY: 'auto', padding: '16px' }}>
              {cart.length === 0 ? (
                <div style={{ textAlign: 'center', padding: '60px 20px', color: '#888' }}>
                  <div style={{ fontSize: '48px', marginBottom: '16px' }}>🛒</div>
                  <p style={{ fontSize: '16px' }}>Your cart is empty</p>
                  <p style={{ fontSize: '13px', marginTop: '8px' }}>Add some products to get started!</p>
                </div>
              ) : (
                cart.map(item => (
                  <div key={item.id} style={{ display: 'flex', gap: '14px', padding: '16px', background: '#222', borderRadius: '12px', marginBottom: '12px', border: '1px solid rgba(255,255,255,0.05)' }}>
                    <img src={item.image} alt={item.name} style={{ width: '72px', height: '72px', objectFit: 'cover', borderRadius: '8px', flexShrink: 0 }} />
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <p style={{ color: 'white', fontWeight: '600', fontSize: '14px', margin: '0 0 4px', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{item.name}</p>
                      <p style={{ color: '#00C853', fontSize: '12px', margin: '0 0 10px' }}>{item.category_name}</p>
                      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '8px', background: '#2A2A2A', borderRadius: '20px', padding: '4px 8px', border: '1px solid rgba(255,255,255,0.08)' }}>
                          <button onClick={() => updateQuantity(item.id, item.quantity - 1)} style={{ background: 'none', border: 'none', color: 'white', cursor: 'pointer', width: '24px', height: '24px', borderRadius: '50%', fontSize: '16px', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>−</button>
                          <span style={{ color: 'white', fontSize: '14px', fontWeight: '600', minWidth: '20px', textAlign: 'center' }}>{item.quantity}</span>
                          <button onClick={() => updateQuantity(item.id, item.quantity + 1)} style={{ background: 'none', border: 'none', color: 'white', cursor: 'pointer', width: '24px', height: '24px', borderRadius: '50%', fontSize: '16px', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>+</button>
                        </div>
                        <span style={{ fontFamily: "'Bebas Neue', sans-serif", fontSize: '20px', color: '#FFD600', letterSpacing: '1px' }}>
                          Ksh {(Number(item.effective_price) * item.quantity).toLocaleString()}
                        </span>
                      </div>
                    </div>
                    <button onClick={() => removeItem(item.id)}
                      style={{ background: 'none', border: 'none', color: '#555', cursor: 'pointer', fontSize: '16px', alignSelf: 'flex-start', padding: '4px', transition: 'color 0.2s' }}
                      onMouseEnter={e => e.target.style.color = '#EF5350'}
                      onMouseLeave={e => e.target.style.color = '#555'}>✕</button>
                  </div>
                ))
              )}
            </div>

            {cart.length > 0 && (
              <div style={{ padding: '20px 24px', borderTop: '1px solid rgba(255,255,255,0.08)', background: '#111' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '8px' }}>
                  <span style={{ color: '#888', fontSize: '13px' }}>Subtotal ({totalItems} items)</span>
                  <span style={{ color: 'white', fontSize: '13px' }}>Ksh {total.toLocaleString()}</span>
                </div>
                <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '8px' }}>
                  <span style={{ color: '#888', fontSize: '13px' }}>Delivery</span>
                  <span style={{ color: '#00C853', fontSize: '13px', fontWeight: '600' }}>Calculated at checkout</span>
                </div>
                <div style={{ display: 'flex', justifyContent: 'space-between', paddingTop: '12px', borderTop: '1px solid rgba(255,255,255,0.08)', marginTop: '8px', marginBottom: '16px' }}>
                  <span style={{ fontFamily: "'Bebas Neue', sans-serif", fontSize: '22px', letterSpacing: '1px', color: 'white' }}>Total</span>
                  <span style={{ fontFamily: "'Bebas Neue', sans-serif", fontSize: '28px', letterSpacing: '1px', color: '#FFD600' }}>Ksh {total.toLocaleString()}</span>
                </div>
                <button
                  onClick={() => setStep('form')}
                  style={{ width: '100%', padding: '16px', background: 'linear-gradient(135deg, #25D366, #128C7E)', color: 'white', border: 'none', borderRadius: '100px', fontFamily: "'Outfit', sans-serif", fontSize: '15px', fontWeight: '800', cursor: 'pointer', marginBottom: '10px', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '10px', transition: 'all 0.3s ease' }}
                  onMouseEnter={e => e.currentTarget.style.transform = 'translateY(-2px)'}
                  onMouseLeave={e => e.currentTarget.style.transform = 'translateY(0)'}
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  Order via WhatsApp
                </button>
                <button onClick={() => onUpdateCart([])} style={{ width: '100%', padding: '10px', background: 'transparent', color: '#888', border: '1px solid rgba(255,255,255,0.08)', borderRadius: '100px', cursor: 'pointer', fontSize: '13px', fontFamily: "'Outfit', sans-serif" }}>
                  Clear Cart
                </button>
              </div>
            )}
          </>
        )}

        {/* ── STEP: Form ── */}
        {step === 'form' && (
          <>
            <div style={{ flex: 1, overflowY: 'auto', padding: '20px 24px' }}>

              {/* Order summary */}
              <div style={{ background: '#222', borderRadius: '12px', padding: '14px 16px', marginBottom: '20px', border: '1px solid rgba(255,255,255,0.05)' }}>
                <div style={{ fontSize: '11px', color: '#888', textTransform: 'uppercase', letterSpacing: '1px', marginBottom: '8px' }}>Order Summary</div>
                {cart.map(item => (
                  <div key={item.id} style={{ display: 'flex', justifyContent: 'space-between', fontSize: '13px', color: '#ccc', marginBottom: '4px' }}>
                    <span>{item.name} x{item.quantity}</span>
                    <span>Ksh {(Number(item.effective_price) * item.quantity).toLocaleString()}</span>
                  </div>
                ))}
                <div style={{ borderTop: '1px solid rgba(255,255,255,0.08)', marginTop: '8px', paddingTop: '8px' }}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '4px' }}>
                    <span style={{ color: '#888', fontSize: '13px' }}>Subtotal</span>
                    <span style={{ color: 'white', fontSize: '13px' }}>Ksh {total.toLocaleString()}</span>
                  </div>
                  <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '4px' }}>
                    <span style={{ color: '#888', fontSize: '13px' }}>Delivery Fee</span>
                    <span style={{ color: '#00C853', fontSize: '13px', fontWeight: '600' }}>Ksh {deliveryFee.toLocaleString()}</span>
                  </div>
                  <div style={{ display: 'flex', justifyContent: 'space-between', paddingTop: '8px', borderTop: '1px solid rgba(255,255,255,0.06)', marginTop: '4px' }}>
                    <span style={{ color: 'white', fontWeight: '700', fontSize: '14px' }}>Total</span>
                    <span style={{ color: '#FFD600', fontFamily: "'Bebas Neue'", fontSize: '20px' }}>
                      Ksh {(total + deliveryFee).toLocaleString()}
                    </span>
                  </div>
                </div>
              </div>

              {/* Name */}
              <label style={labelStyle}>Full Name *</label>
              <input
                style={inputStyle('customer_name')}
                placeholder="e.g. John Kamau"
                value={form.customer_name}
                onChange={e => { setForm({ ...form, customer_name: e.target.value }); setErrors({ ...errors, customer_name: '' }); }}
              />
              {errors.customer_name && <p style={{ color: '#EF5350', fontSize: '11px', marginBottom: '10px' }}>{errors.customer_name}</p>}

              {/* Delivery Area */}
              <label style={labelStyle}>Delivery Area</label>
              <input
                style={inputStyle('delivery_area')}
                placeholder="e.g. Westlands, Nairobi"
                value={form.delivery_area}
                onChange={e => setForm({ ...form, delivery_area: e.target.value })}
              />

              {/* Delivery Type */}
              <label style={labelStyle}>Delivery Type</label>
              <select
                style={{ ...inputStyle('delivery_type'), marginBottom: '12px', cursor: 'pointer' }}
                value={form.delivery_type}
                onChange={e => setForm({ ...form, delivery_type: e.target.value })}
              >
                <option value="nairobi">Nairobi Delivery — Ksh 200</option>
                <option value="upcountry">Upcountry Delivery — Ksh 500</option>
                <option value="pickup">Pick Up — Free</option>
              </select>

              {/* Payment Method */}
              <label style={labelStyle}>Payment Method</label>
              <select
                style={{ ...inputStyle('payment_method'), marginBottom: '12px', cursor: 'pointer' }}
                value={form.payment_method}
                onChange={e => setForm({ ...form, payment_method: e.target.value })}
              >
                <option value="mpesa">M-Pesa</option>
                <option value="cash">Cash on Delivery</option>
                <option value="bank">Bank Transfer</option>
              </select>

              {/* Notes */}
              <label style={labelStyle}>Notes (optional)</label>
              <textarea
                style={{ ...inputStyle('notes'), resize: 'none', height: '80px' }}
                placeholder="Any special instructions or requests..."
                value={form.notes}
                onChange={e => setForm({ ...form, notes: e.target.value })}
              />
            </div>

            <div style={{ padding: '16px 24px', borderTop: '1px solid rgba(255,255,255,0.08)', background: '#111', display: 'flex', gap: '10px' }}>
              <button
                onClick={() => setStep('cart')}
                style={{ flex: 1, padding: '14px', background: 'transparent', color: '#888', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '100px', cursor: 'pointer', fontSize: '13px', fontFamily: "'Outfit', sans-serif" }}
              >← Back</button>
              <button
                onClick={handleCheckout}
                style={{ flex: 2, padding: '14px', background: 'linear-gradient(135deg, #25D366, #128C7E)', color: 'white', border: 'none', borderRadius: '100px', fontFamily: "'Outfit', sans-serif", fontSize: '14px', fontWeight: '800', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '8px', transition: 'all 0.3s ease' }}
                onMouseEnter={e => e.currentTarget.style.transform = 'translateY(-2px)'}
                onMouseLeave={e => e.currentTarget.style.transform = 'translateY(0)'}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Confirm & Order
              </button>
            </div>
          </>
        )}

        {/* ── STEP: Loading ── */}
        {step === 'loading' && (
          <div style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: '16px', color: '#888' }}>
            <div style={{ width: '48px', height: '48px', border: '3px solid rgba(0,200,83,0.2)', borderTopColor: '#00C853', borderRadius: '50%', animation: 'spin 0.8s linear infinite' }} />
            <p style={{ fontSize: '15px' }}>Saving your order...</p>
          </div>
        )}

        {/* ── STEP: Done ── */}
        {step === 'done' && (
          <div style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: '16px', padding: '40px', textAlign: 'center' }}>
            <div style={{ fontSize: '64px' }}>🎉</div>
            <h3 style={{ fontFamily: "'Bebas Neue', sans-serif", fontSize: '32px', color: 'white', letterSpacing: '1px', margin: 0 }}>Order Placed!</h3>
            <p style={{ color: '#888', fontSize: '14px', lineHeight: '1.7' }}>
              Your order has been recorded and WhatsApp has opened. Complete your order by sending the message to us!
            </p>
            <button
              onClick={onClose}
              style={{ padding: '14px 32px', background: 'linear-gradient(135deg, #00C853, #69F0AE)', color: 'black', border: 'none', borderRadius: '100px', fontFamily: "'Outfit', sans-serif", fontSize: '15px', fontWeight: '800', cursor: 'pointer', marginTop: '8px' }}
            >Done</button>
          </div>
        )}
      </div>

      <style>{`
        @keyframes slideInRight {
          from { transform: translateX(100%); opacity: 0; }
          to { transform: translateX(0); opacity: 1; }
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        select option { background: #222; color: white; }
        input::placeholder, textarea::placeholder { color: #555; }
      `}</style>
    </>
  );
}

export default Cart;
